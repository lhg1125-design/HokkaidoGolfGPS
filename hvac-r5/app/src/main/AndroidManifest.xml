<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"/>
    <application android:theme="@android:style/Theme.Material.NoActionBar"
        android:label="VWID HVAC R5.3 DIAG"
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <receiver android:name=".HvacWidgetLightBrown" android:exported="true" android:label="VWID HVAC - Light Brown">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_lb"/>
        </receiver>
        <receiver android:name=".HvacWidgetDeepRed" android:exported="true" android:label="VWID HVAC - Deep Red">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_red"/>
        </receiver>
        <receiver android:name=".HvacWidgetDarkLavender" android:exported="true" android:label="VWID HVAC - Dark Lavender">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_lav"/>
        </receiver>
        <receiver android:name=".McuFrameReceiver" android:exported="true">
            <intent-filter>
                <action android:name="com.vwid.hvacbridge.RAW_FRAME"/>
                <action android:name="com.vwid.hvacbridge.SET_STATE"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>
